    }
  },
  "screen": { "type": { "body": 16, "small": 12, "sub": 18, "title": 28, "display": 48 } },
  "print": {
    "margin": { "top": 12, "right": 14, "bottom": 15, "left": 22, "indent": 28, "gutter": 11 },
    "type": { "body": 11, "leading": 16, "heading": 24, "sub": 12, "small": 9, "cover": 30, "summary": 16 }
  },
  "font": {
    "latin": [
      "Arial",
      "Helvetica Neue"
    ],
    "cjk": [
      "PingFang TC",
      "Microsoft JhengHei"
    ],
    "slide": "Microsoft JhengHei",
    "numerals": "tabular",
    "italic": false,
    "display": [
      "Cambria",
      "PMingLiU",
      "Songti TC"
    ]
  },
  "type": {
    "display": {
      "px": 96,
      "weight": 600
    },
    "statement": {
      "px": 88,
      "weight": 600,
      "color": "#111111"
    },
    "number": {
      "px": 120,
      "weight": 300,
      "color": "#111111"
    },
    "conclusionNumber": {
      "px": 88,
      "weight": 300,
      "color": "#28317B"
    },
    "title": {
      "px": 56,
      "weight": 600,
      "color": "#000099"
    },
    "sub": {
      "px": 36,
      "weight": 400
    },
    "body": {
      "px": 40,
      "weight": 400,
      "color": "#111111"
    },
    "chartTitle": {
      "px": 32,
      "weight": 600,
      "color": "#000099"
    },
    "tableBody": {
      "px": 32,
      "weight": 400,
      "emphasisWeight": 600,
      "color": "#111111"
    },
    "tableHeader": {
      "px": 24,
      "weight": 400,
      "color": "#4A4A4A"
    },
    "chart": {
      "px": 32,
      "weight": 400,
      "color": "#4A4A4A"
    },
    "label": {
      "px": 24,
      "weight": 400,
      "color": "#4A4A4A"
    },
    "minimum": 24,
    "section": {
      "px": 78
    }
  },
  "stroke": {
    "grid": 1,
    "axis": 1,
    "focusRule": 4,
    "focusLine": 3,
    "otherLine": 1.5,
    "tickLong": 14,
    "tickShort": 7,
    "axisTick": 8
  },
  "sourceRow": {
    "maxLines": 2,
    "overflow": "warn",
    "shrinkText": false,
    "fields": [
      "source",
      "unit",
      "period",
      "missing"
    ]
  },
  "color": {
    "text": "#111111",
    "textSecondary": "#4A4A4A",
    "grid": "#E3E3E6",
    "gray": "#7F7F7F",
    "title": "#000099",
    "dark": "#142979",
    "onDark": [
      "#FFFFFF",
      "#BDCCED"
    ],
    "tint": "#F6F6FA",
    "focus": "#28317B",
    "ordered": [
      "#9DB1D9",
      "#8A9CCB",
      "#7285BB",
      "#4B5A9C",
      "#28317B"
    ],
    "categorical": [
      "#28317B",
      "#04696C",
      "#6A9A3A",
      "#B57FCF"
    ],
    "other": "#DDDDDD",
    "better": "#015224",
    "worse": "#9D2324",
    "unchanged": "#4A4A4A",
    "cover": "#000066"
  },
  "textOnFill": {},
  "categoryRules": {
    "stableColorPerCategory": true,
    "otherByName": "其他",
    "maxCategorical": 4
  },
  "delta": {
    "signs": {
      "increase": "＋",
      "decrease": "−",
      "unchanged": "±0"
    },
    "better": {
      "values": [
        "higher",
        "lower"
      ],
      "default": "higher"
    },
    "colorAppliesTo": "deltaLabelOnly",
    "noPrevious": "omit",
    "previousZero": "absoluteOnly",
    "percentOfPercent": "個百分點"
  },
  "dataDisplay": {
    "zero": "plotAndLabel",
    "missing": {
      "plot": false,
      "sourceField": "未提供：{item}"
    },
    "roundsToZero": {
      "positive": "<{precision}",
      "negative": ">−{precision}"
    },
    "labelsFormatOnly": true
  },
  "heatmap": {
    "steps": 5,
    "binning": "equalWidth",
    "from": 0,
    "to": "max",
    "legendShowsRanges": true
  },
  "fill": {
    "estimate": {
      "svg": {
        "pattern": "hatch",
        "angle": 45,
        "stroke": "#28317B",
        "width": 1.5,
        "spacing": 7,
        "outline": "#28317B"
      },
      "native": {
        "color": "#9DB1D9",
        "labelSuffix": "預估"
      }
    },
    "other": {
      "svg": {
        "pattern": "hatch",
        "angle": 45,
        "stroke": "#DDDDDD",
        "width": 2,
        "spacing": 7
      },
      "native": {
        "color": "#DDDDDD"
      }
    }
  },
